default_platform(:ios)

APP_IDENTIFIER = "macbookair31f.------------------"
APPLE_ID = "6766872256"
METADATA_PATH = "./fastlane/metadata"
SCREENSHOTS_PATH = "./fastlane/screenshots"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID", "8SW8Y424Z3"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID", "2184b121-7698-4d87-96a1-494bd57d79b2"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEYFILEPATH", "/Users/ll/Downloads/AuthKey_8SW8Y424Z3.p8"),
    duration: 1200,
    in_house: false
  )
end

def asc_token
  Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID", "8SW8Y424Z3"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID", "2184b121-7698-4d87-96a1-494bd57d79b2"),
    filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEYFILEPATH", "/Users/ll/Downloads/AuthKey_8SW8Y424Z3.p8"),
    duration: 1200,
    in_house: false
  )
end

def app_review_information
  {
    first_name: ENV.fetch("APP_REVIEW_FIRST_NAME"),
    last_name: ENV.fetch("APP_REVIEW_LAST_NAME"),
    phone_number: ENV.fetch("APP_REVIEW_PHONE"),
    email_address: ENV.fetch("APP_REVIEW_EMAIL"),
    demo_user: "",
    demo_password: "",
    notes: "No demo account is required. The app is an offline educational practice tool."
  }
end

platform :ios do
  desc "Upload App Store metadata, privacy URL, support URL, and app info fields"
  lane :upmeta do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APPLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      copyright: "© 2026 Chen Tingting",
      primary_category: "EDUCATION",
      secondary_category: "REFERENCE",
      app_review_information: app_review_information
    )
  end

  desc "Upload App Store screenshots only"
  lane :uppic do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APPLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_metadata: true,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Check App Store Connect app visibility through API key"
  lane :status do
    Spaceship::ConnectAPI.token = asc_token
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for #{APP_IDENTIFIER}") unless app
    UI.message("Found #{app.name} (#{app.bundle_id})")
  end

  desc "Verify uploaded zh-Hans metadata fields on App Store Connect"
  lane :verify_meta do
    Spaceship::ConnectAPI.token = asc_token
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for #{APP_IDENTIFIER}") unless app

    version = app.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("Editable App Store version not found") unless version

    version_loc = version.get_app_store_version_localizations.find { |loc| loc.locale == "zh-Hans" }
    app_info = app.fetch_edit_app_info
    app_info_loc = app_info.get_app_info_localizations.find { |loc| loc.locale == "zh-Hans" }

    checks = {
      "name" => app.name,
      "version" => version.version_string,
      "description" => version_loc&.description,
      "keywords" => version_loc&.keywords,
      "promotional_text" => version_loc&.promotional_text,
      "support_url" => version_loc&.support_url,
      "privacy_policy_url" => app_info_loc&.privacy_policy_url
    }

    checks.each do |key, value|
      UI.message("#{key}: #{value.to_s.empty? ? "MISSING" : "OK"}")
    end

    missing = checks.select { |key, value| key != "version" && value.to_s.empty? }
    UI.user_error!("Missing metadata fields: #{missing.keys.join(", ")}") unless missing.empty?
  end
end
