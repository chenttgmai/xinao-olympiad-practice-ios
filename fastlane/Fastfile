default_platform(:ios)

APP_IDENTIFIER = "macbookair31f.------------------"
APPLE_ID = "6766872256"
METADATA_PATH = "./fastlane/metadata"
SCREENSHOTS_PATH = "./fastlane/screenshots"
AGE_RATING_CONFIG_PATH = "./fastlane/age_rating_config.json"
APP_PRIVACY_DETAILS_PATH = "./fastlane/app_privacy_details.json"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID", "8SW8Y424Z3"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID", "2184b121-7698-4d87-96a1-494bd57d79b2"),
    key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEYFILEPATH", "/Users/ll/Downloads/AuthKey_8SW8Y424Z3.p8"),
    duration: 1200,
    in_house: false
  )
end

def asc_token
  Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID", "8SW8Y424Z3"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID", "2184b121-7698-4d87-96a1-494bd57d79b2"),
    filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEYFILEPATH", "/Users/ll/Downloads/AuthKey_8SW8Y424Z3.p8"),
    duration: 1200,
    in_house: false
  )
end

def app_review_information
  {
    first_name: ENV.fetch("APP_REVIEW_FIRST_NAME"),
    last_name: ENV.fetch("APP_REVIEW_LAST_NAME"),
    phone_number: ENV.fetch("APP_REVIEW_PHONE"),
    email_address: ENV.fetch("APP_REVIEW_EMAIL"),
    demo_user: "",
    demo_password: "",
    notes: "No demo account is required. The app is an offline educational practice tool."
  }
end

platform :ios do
  desc "Upload App Store metadata, privacy URL, support URL, and app info fields"
  lane :upmeta do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APPLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      copyright: "© 2026 Chen Tingting",
      primary_category: "EDUCATION",
      secondary_category: "REFERENCE",
      app_rating_config_path: AGE_RATING_CONFIG_PATH,
      app_review_information: app_review_information
    )
  end

  desc "Repair required App Store review fields without submitting for review"
  lane :review_fields do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APPLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: true,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      copyright: "© 2026 Chen Tingting",
      primary_category: "EDUCATION",
      secondary_category: "REFERENCE",
      app_rating_config_path: AGE_RATING_CONFIG_PATH,
      submission_information: {
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      },
      app_review_information: app_review_information
    )
  end

  desc "Set App Store price to CNY 1 using the current App Store Connect price schedule API"
  lane :price_cny1 do
    require "json"
    require "net/http"
    require "uri"

    Spaceship::ConnectAPI.token = asc_token
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for #{APP_IDENTIFIER}") unless app

    token = Spaceship::ConnectAPI.token.text
    headers = {
      "Authorization" => "Bearer #{token}",
      "Accept" => "application/json",
      "Content-Type" => "application/json"
    }

    request_json = lambda do |method, path, body = nil|
      uri = URI("https://api.appstoreconnect.apple.com#{path}")
      request = method == :post ? Net::HTTP::Post.new(uri) : Net::HTTP::Get.new(uri)
      headers.each { |key, value| request[key] = value }
      request.body = JSON.generate(body) if body
      response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(request) }
      UI.user_error!("#{method.upcase} #{path} failed: #{response.code} #{response.body}") unless response.code.to_i.between?(200, 299)
      JSON.parse(response.body)
    end

    points = request_json.call(:get, "/v1/apps/#{app.id}/appPricePoints?filter[territory]=CHN&limit=20")
    price_point = points.fetch("data").find { |point| point.dig("attributes", "customerPrice") == "1.0" }
    UI.user_error!("CNY 1.0 price point not found") unless price_point

    local_price_id = "${newprice-0}"
    request_json.call(
      :post,
      "/v1/appPriceSchedules",
      {
        data: {
          type: "appPriceSchedules",
          attributes: {},
          relationships: {
            app: { data: { type: "apps", id: app.id } },
            baseTerritory: { data: { type: "territories", id: "CHN" } },
            manualPrices: { data: [{ type: "appPrices", id: local_price_id }] }
          }
        },
        included: [
          {
            type: "appPrices",
            id: local_price_id,
            attributes: { startDate: nil, endDate: nil },
            relationships: {
              appPricePoint: { data: { type: "appPricePoints", id: price_point.fetch("id") } }
            }
          }
        ]
      }
    )

    UI.success("Set App Store price to CNY 1.0")
  end

  desc "Upload App Privacy answer: Data Not Collected"
  lane :upprivacy do
    upload_app_privacy_details_to_app_store(
      app_identifier: APP_IDENTIFIER,
      json_path: APP_PRIVACY_DETAILS_PATH,
      skip_publish: false
    )
  end

  desc "Upload App Store screenshots only"
  lane :uppic do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app: APPLE_ID,
      metadata_path: METADATA_PATH,
      screenshots_path: SCREENSHOTS_PATH,
      skip_metadata: true,
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Check App Store Connect app visibility through API key"
  lane :status do
    Spaceship::ConnectAPI.token = asc_token
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for #{APP_IDENTIFIER}") unless app
    UI.message("Found #{app.name} (#{app.bundle_id})")
  end

  desc "Verify uploaded zh-Hans metadata fields on App Store Connect"
  lane :verify_meta do
    Spaceship::ConnectAPI.token = asc_token
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("App not found for #{APP_IDENTIFIER}") unless app

    version = app.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("Editable App Store version not found") unless version

    version_loc = version.get_app_store_version_localizations.find { |loc| loc.locale == "zh-Hans" }
    app_info = app.fetch_edit_app_info
    app_info_loc = app_info.get_app_info_localizations.find { |loc| loc.locale == "zh-Hans" }

    checks = {
      "name" => app.name,
      "version" => version.version_string,
      "description" => version_loc&.description,
      "keywords" => version_loc&.keywords,
      "promotional_text" => version_loc&.promotional_text,
      "support_url" => version_loc&.support_url,
      "privacy_policy_url" => app_info_loc&.privacy_policy_url
    }

    checks.each do |key, value|
      UI.message("#{key}: #{value.to_s.empty? ? "MISSING" : "OK"}")
    end

    missing = checks.select { |key, value| key != "version" && value.to_s.empty? }
    UI.user_error!("Missing metadata fields: #{missing.keys.join(", ")}") unless missing.empty?
  end
end
